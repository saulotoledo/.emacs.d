(progn
  ;; Provide a generic safe icon caller.
  ;; Usage: (my/safe-icon FN &rest ARGS)
  ;; where FN is a symbol naming an all-the-icons function (e.g.
  ;; 'all-the-icons-fileicon, 'all-the-icons-faicon, 'all-the-icons-octicon)
  ;; or a function object. Returns a spacer string on error.
  (defun my/safe-icon (fn &rest args)
    "Safely call icon function FN with ARGS, returning a spacer on error.
If FN is a symbol, its function-value is used. Any error is caught and
an empty space string is returned to avoid breaking startup.
"
    (condition-case err
        (let ((f (if (symbolp fn) (symbol-function fn) fn)))
          (apply f args))
      (error
       (message "[my/safe-icon] icon error calling %s: %s" fn err)
       " ")))


{
  "defaultBehavior" : "agent",
  "defaultModel" : "github-copilot/gpt-4.1",
  "completion": {
    "model": "ollama/qwen2.5:3b",
    "enabled": true
  },
  "toolCall" : {
    "approval" : {
      "byDefault" : "ask",
      "allow" : {
        "eca__read_file" : {},
        "eca__directory_tree" : {},
        "eca__grep" : {},
        "eca__preview_file_change" : {},
        "eca__editor_diagnostics" : {}
      },
      "ask" : {
        "eca__editor_append_content" : {},
        "eca__edit_file" : {},
        "eca__write_file" : {},
        "eca__move_file" : {}
      },
      "deny" : {
        "eca__read_file" : {
          "argsMatchers" : {
            "path" : [
              ".*\\.env$",
              ".*\\.env\\..*",
              ".*\\.secret$",
              ".*\\.key$",
              ".*\\.gpg$",
              ".*\\.pem$",
              ".*\\.p12$",
              ".*\\.pfx$",
              ".*\\.jks$",
              ".*\\.keystore$",
              ".*\\.credentials$",
              ".*\\.authinfo.*",
              ".*\\.netrc$",
              ".*/secrets/.*",
              ".*/\\.ssh/.*",
              ".*/\\.aws/.*",
              ".*/\\.config/.*/.*secret.*"
            ]
          }
        }
      }
    }
  },
  "providers" : {
    "anthropic" : {
      "key" : "${env:ANTHROPIC_API_KEY}"
    },
    "deepseek" : {
      "api" : "deepseek",
      "url" : "https://api.deepseek.com",
      "key" : "${env:DEEPSEEK_API_KEY}",
      "models" : {
        "deepseek-reasoner" : { },
        "deepseek-chat" : { }
      }
    },
    "google" : {
      "key" : "${env:GEMINI_API_KEY}"
    },
    "groq" : {
      "api" : "groq",
      "url" : "https://api.groq.com/openai/v1",
      "key" : "${env:GROQ_API_KEY}",
      "fetchModels" : true
    },
    "moonshot" : {
      "api" : "moonshot",
      "url" : "https://api.moonshot.ai/v1",
      "key" : "${env:MOONSHOT_API_KEY}",
      "models" : {
        "moonshot-v1-8k" : { },
        "moonshot-v1-32k" : { }
      }
    },
    "novita" : {
      "api" : "novita",
      "url" : "https://api.novita.ai/v3/openai",
      "key" : "${env:NOVITA_API_KEY}",
      "fetchModels" : true
    },
    "openai" : {
      "key" : "${env:OPENAI_API_KEY}"
    },
    "openrouter" : {
      "api": "openai-chat",
      "url" : "https://openrouter.ai/api/v1",
      "key" : "${env:OPENROUTER_API_KEY}",
      "fetchModels" : true,
      "models" : {
        "qwen/qwen-2.5-vl-7b-instruct:free" : {
          "extraPayload": { "max_tokens": 2048 }
        }
      }
    },
    "perplexity" : {
      "api" : "perplexity",
      "url" : "https://api.perplexity.ai",
      "key" : "${env:PERPLEXITY_API_KEY}",
      "models" : {
        "sonar-reasoning-pro" : { },
        "sonar-pro" : { }
      }
    },
    "mistral" : {
      "api" : "openai-chat",
      "url" : "https://api.mistral.ai",
      "completionUrlRelativePath": "/v1/chat/completions",
      "key" : "${env:MISTRAL_API_KEY}",
      "models" : {
        "codestral-latest" : {
          "extraPayload": { "max_completion_tokens": null }
        },
        "codestral-2508" : {
          "extraPayload": { "max_completion_tokens": null }
        },
        "devstral-latest" : {
          "extraPayload": { "max_completion_tokens": null }
        },
        "devstral-2512" : {
          "extraPayload": { "max_completion_tokens": null }
        },
        "devstral-2512:free" : {
          "extraPayload": { "max_completion_tokens": null }
        }
      }
    },
    "huggingface" : {
      "api" : "openapi-chat",
      "url" : "https://router.huggingface.co/v1",
      "key" : "${env:HUGGINGFACE_API_KEY}",
      "fetchModels" : true
    },
    "ollama" : {
      "api" : "openai-chat",
      "url" : "http://localhost:11434",
      "key" : "",
      "fetchModels" : true
    }
  },
  "mcpServers" : { }
}
